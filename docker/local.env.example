# Local Docker Compose configuration only. Never use these local secrets in production.

# Laravel
APP_NAME=Oxygen
APP_ENV=local
APP_KEY=base64:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
APP_DEBUG=true
APP_URL=http://localhost:8000
ALLOW_REGISTER=true
RUN_MIGRATIONS=true
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# PostgreSQL shared by Laravel and Go Queue
DB_CONNECTION=pgsql
DB_HOST=stream-postgres
DB_PORT=5432
DB_DATABASE=oxygen
DB_USERNAME=oxygen
DB_PASSWORD=oxygen-local-password
DB_SSLMODE=disable
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
SESSION_DRIVER=database

# Redis shared by Laravel and Go Queue
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=my-redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_ADDR=my-redis:6379

# Cloud S3 or Cloudflare R2 source bucket used by Laravel and Go Queue.
# For AWS S3, leave AWS_ENDPOINT empty and normally use us-east-1 or your bucket region.
# For R2, use AWS_DEFAULT_REGION=auto and AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=yVV7tPNuXZ7yik6xqG65
AWS_SECRET_ACCESS_KEY=8VoqKu7b3RQIaBvH3TkwmBbOeMzOxKlENME2xGsM
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=oxygen-stream
AWS_ENDPOINT=http://rustfs_local:9000
AWS_URL=http://rustfs_local:9000/oxygen-stream
AWS_USE_PATH_STYLE_ENDPOINT=true

# Go Queue
TRANSCODE_QUEUE_KEY=queues:transcode
TRANSCODE_WEBHOOK_QUEUE_KEY=queues:transcode:webhooks
QUEUE_KEY=oxygen-database-queues:transcode
WORKER_CONCURRENCY=1
WORK_DIR=/tmp/transcoder

SOURCE_AWS_BUCKET=<SOURCE_BUCKET>
SOURCE_AWS_ENDPOINT=
SOURCE_AWS_URL=
SOURCE_AWS_USE_PATH_STYLE_ENDPOINT=true

STREAMING_AWS_BUCKET=<STREAMING_BUCKET>
STREAMING_AWS_ENDPOINT=
STREAMING_AWS_URL=<PUBLIC_STREAMING_OR_CDN_URL>
STREAMING_AWS_USE_PATH_STYLE_ENDPOINT=true
STREAMING_AWS_DEFAULT_REGION=

FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe
FFMPEG_VIDEO_CODEC=libx264
PROGRESS_MIN_INTERVAL_MS=2000
HLS_PREFIX=hls

# Go Live and Laravel live-control settings
LIVE_ADDR=:8081
LIVE_RTMP_ADDR=:1935
LIVE_HLS_ROOT=/var/lib/oxygen-live/hls
LIVE_CALLBACK_ROOT=/var/lib/oxygen-live/callbacks
LARAVEL_URL=http://127.0.0.1:8000

LIVE_RTMP_URL=rtmp://localhost:1935/live
LIVE_HLS_URL=http://localhost:8081/live
LIVE_SERVICE_TOKEN=local-live-service-token-change-before-production
LIVE_CONTROL_URL=http://127.0.0.1:8081
LIVE_CONTROL_TOKEN=local-live-control-token-change-before-production
LIVE_ALLOW_INSECURE_CONTROL=false
LIVE_TRUST_PROXY_HEADERS=false

MAX_TRACKED_VIEWERS=100000
MAX_RTMP_CONNECTIONS=1000
VIEWER_TTL_SECONDS=45
ROLLUP_INTERVAL_SECONDS=15

MAIL_MAILER=log
